<Layouts.app flash={@flash}>
  <.header>
    Edit Student {@student.id}
    <:subtitle>Use this form to manage student records in your database.</:subtitle>
  </.header>

  <.student_form
    changeset={@changeset}
    action={~p"/students/#{@student}"}
    return_to={~p"/students"}
  />
</Layouts.app>
